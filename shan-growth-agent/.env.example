# =============================================================================
# Shan Growth Agent - Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Target site ---
SITE_URL=https://www.scuolakungfucipriani.it/
SITE_NAME=Scuola Kung Fu Maestro Cipriani
SITE_INSTAGRAM_HANDLE=scuolacipriani

# --- Runtime ---
SHAN_ENV=production
SHAN_LOG_LEVEL=INFO
SHAN_TIMEZONE=Europe/Rome
SHAN_DATA_DIR=/app/data

# --- Web dashboard (LAN only - bind on 0.0.0.0 only because container is in host net) ---
SHAN_API_HOST=0.0.0.0
SHAN_API_PORT=8765
# Optional simple bearer token for read-only dashboard access (leave empty to disable)
SHAN_API_TOKEN=

# --- LLM provider selection: "anthropic" | "openai" ---
LLM_PROVIDER=anthropic

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Telegram notifier ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Search Console (service account JSON path, mounted read-only) ---
GSC_SERVICE_ACCOUNT_JSON=/app/secrets/gsc-sa.json
GSC_SITE_PROPERTY=sc-domain:scuolakungfucipriani.it

# --- PageSpeed Insights API ---
PAGESPEED_API_KEY=

# --- Instagram Graph API (Business/Creator account via FB Login for Business) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_ID=
IG_APP_SECRET=

# --- IndexNow (Bing/others) ---
INDEXNOW_KEY=
