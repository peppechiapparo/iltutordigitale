# =============================================================================
# Tutor Engine — Environment Configuration
# Copia in .env e compila con i valori reali. NON committare .env.
# =============================================================================

# --- Target site ---
SITE_URL=https://tutordigitale.com/
SITE_NAME=Il Tutor Digitale
SITE_INSTAGRAM_HANDLE=iltutordigitale
SITE_YOUTUBE_HANDLE=iltutordigitale
SITE_FACEBOOK_HANDLE=iltutordigitale
YOUTUBE_CHANNEL_ID=            # da impostare quando il canale YouTube è attivo

# --- Runtime ---
TUTOR_ENV=production
TUTOR_LOG_LEVEL=INFO
TUTOR_TIMEZONE=Europe/Rome
TUTOR_DATA_DIR=/app/data

# --- Web dashboard (solo LAN — bind su 0.0.0.0 perché il container usa host net) ---
TUTOR_API_HOST=0.0.0.0
TUTOR_API_PORT=8765
# Token opzionale per accesso read-only alla dashboard (lascia vuoto per disabilitare)
TUTOR_API_TOKEN=

# --- LLM provider: "anthropic" | "openai" | "github_models" ---
LLM_PROVIDER=github_models

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub Models (usa il tuo GitHub PAT — nessuno scope necessario)
# Genera su: https://github.com/settings/tokens → New token (classic) → lascia TUTTO deselezionato
GITHUB_TOKEN=ghp_IL_TUO_PAT_GITHUB_QUI
GITHUB_MODEL=gpt-4.1

# --- Telegram (gate umano + notifiche) ---
TELEGRAM_BOT_TOKEN=8646347616:AAHrfn_u1DB96KAQg8UiU2DhaCVl_dhZjvU
TELEGRAM_CHAT_ID=8718535016

# --- Google Search Console (service account JSON path, montato in read-only) ---
GSC_SERVICE_ACCOUNT_JSON=/app/secrets/gsc-sa.json
GSC_SITE_PROPERTY=sc-domain:tutordigitale.com

# --- PageSpeed Insights API ---
PAGESPEED_API_KEY=

# --- Instagram Graph API (per SocialPublisher — Fase 2+) ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_ID=
IG_APP_SECRET=

# --- YouTube Analytics API (per YouTubeMonitor — Fase 3) ---
YOUTUBE_API_KEY=

# --- Cloudflare Analytics (per WeeklyReport) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- IndexNow (Bing/others — per SEOMonitor) ---
INDEXNOW_KEY=
