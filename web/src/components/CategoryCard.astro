---
import type { SiteCategory } from '@/data/site';

interface Props {
  categoryKey: SiteCategory;
  label: string;
  description: string;
  count?: number;
}
const { categoryKey, label, description, count = 0 } = Astro.props;

const styles: Record<SiteCategory, { iconBg: string; iconColor: string }> = {
  smartphone: { iconBg: 'bg-brand-blue',      iconColor: 'text-white' },
  pc:         { iconBg: 'bg-brand-dark',      iconColor: 'text-white' },
  whatsapp:   { iconBg: 'bg-brand-blue-mid',  iconColor: 'text-white' },
  sicurezza:  { iconBg: 'bg-brand-orange',    iconColor: 'text-brand-dark' },
  app:        { iconBg: 'bg-brand-orange-lt', iconColor: 'text-brand-dark' },
};

const icons: Record<SiteCategory, string> = {
  smartphone: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
  pc:         `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
  whatsapp:   `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  sicurezza:  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  app:        `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
};

const { iconBg, iconColor } = styles[categoryKey];
---

<a
  href={`/categoria/${categoryKey}`}
  class="group flex flex-col bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-200 p-6 focus-visible:outline-3 focus-visible:outline-brand-orange"
>
  <span
    class={`inline-flex items-center justify-center w-14 h-14 rounded-2xl ${iconBg} ${iconColor} mb-5 flex-shrink-0`}
  >
    <Fragment set:html={icons[categoryKey]} />
  </span>
  <span class="font-heading text-xl font-bold text-brand-dark group-hover:text-brand-blue transition-colors leading-snug">
    {label}
  </span>
  <span class="mt-2 text-brand-mid text-sm leading-relaxed flex-1">
    {description}
  </span>
  {count > 0 && (
    <span class="mt-4 text-xs font-semibold text-brand-blue group-hover:text-brand-blue-mid transition-colors">
      {count} {count === 1 ? 'guida' : 'guide'} disponibili →
    </span>
  )}
</a>
