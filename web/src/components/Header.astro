---
import { SITE, CATEGORIES } from '@/data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm">
  <div class="mx-auto max-w-6xl px-4 h-24 flex items-center justify-between gap-6">

    <!-- Logo -->
    <a href="/" class="flex-shrink-0 group" aria-label={`${SITE.name} — Home`}>
      <img
        src="/logo.png"
        alt={SITE.name}
        class="h-20 w-auto transition-opacity group-hover:opacity-85"
        width="80"
        height="80"
        loading="eager"
      />
    </a>

    <!-- Nav desktop -->
    <nav class="hidden lg:flex items-center gap-2 flex-1 justify-center" aria-label="Navigazione principale">
      {
        Object.entries(CATEGORIES).map(([key, c]) => (
          <a
            href={`/categoria/${key}`}
            class:list={[
              'flex items-center gap-2 px-4 py-2.5 rounded-xl text-base font-semibold transition-colors whitespace-nowrap',
              isActive(`/categoria/${key}`)
                ? 'bg-brand-blue text-white shadow-sm'
                : 'text-brand-dark hover:bg-brand-blue-light hover:text-brand-blue',
            ]}
          >
            <span aria-hidden="true" class="text-lg">{c.emoji}</span>
            {c.label}
          </a>
        ))
      }
    </nav>

    <!-- Azioni -->
    <div class="flex items-center gap-3 flex-shrink-0">
      <a
        href="/tutorial"
        class="hidden md:inline-flex items-center bg-brand-orange hover:bg-brand-orange-dk text-brand-dark font-bold text-base px-5 py-3 rounded-xl transition-colors min-h-[48px] whitespace-nowrap shadow-sm"
      >
        Tutte le guide
      </a>
      <button
        id="menu-toggle"
        class="lg:hidden p-3 rounded-xl text-brand-dark hover:bg-brand-bg transition-colors"
        aria-label="Apri il menu di navigazione"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-gray-100 bg-white"
    role="navigation"
    aria-label="Menu mobile"
  >
    <div class="px-4 py-4 space-y-2">
      {
        Object.entries(CATEGORIES).map(([key, c]) => (
          <a
            href={`/categoria/${key}`}
            class:list={[
              'flex items-center gap-4 px-4 py-4 rounded-2xl text-lg font-semibold transition-colors',
              isActive(`/categoria/${key}`)
                ? 'bg-brand-blue text-white'
                : 'text-brand-dark hover:bg-brand-blue-light hover:text-brand-blue',
            ]}
          >
            <span class="text-2xl w-8 text-center" aria-hidden="true">{c.emoji}</span>
            {c.label}
          </a>
        ))
      }
      <div class="pt-3 border-t border-gray-100">
        <a
          href="/tutorial"
          class="flex items-center justify-center bg-brand-orange hover:bg-brand-orange-dk text-brand-dark font-bold py-4 px-4 rounded-2xl min-h-[56px] text-lg transition-colors shadow-sm"
        >
          Tutte le guide
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const iMenu  = document.getElementById('icon-menu');
  const iClose = document.getElementById('icon-close');
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iMenu?.classList.toggle('hidden', !isOpen);
    iClose?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Apri il menu di navigazione' : 'Chiudi il menu');
  });
</script>
