---
import { SITE, CATEGORIES } from '@/data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm">
  <div class="mx-auto max-w-6xl px-4 h-20 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-1 group flex-shrink-0" aria-label={`${SITE.name} — Home`}>
      <img
        src="/logo.png"
        alt={SITE.name}
        class="h-12 w-auto"
        width="48"
        height="48"
        loading="eager"
      />
    </a>

    <!-- Nav desktop -->
    <nav class="hidden lg:flex items-center gap-0.5 flex-1 justify-center" aria-label="Navigazione principale">
      {
        Object.entries(CATEGORIES).map(([key, c]) => (
          <a
            href={`/categoria/${key}`}
            class:list={[
              'px-3 py-2 rounded-lg text-sm font-medium transition-colors whitespace-nowrap',
              isActive(`/categoria/${key}`)
                ? 'bg-brand-blue-light text-brand-blue'
                : 'text-brand-dark hover:bg-brand-bg hover:text-brand-blue',
            ]}
          >
            <span aria-hidden="true" class="mr-1">{c.emoji}</span>{c.label}
          </a>
        ))
      }
    </nav>

    <!-- Azioni -->
    <div class="flex items-center gap-2 flex-shrink-0">
      <a
        href="/tutorial"
        class="hidden md:inline-flex items-center bg-brand-orange hover:bg-brand-orange-dk text-brand-dark font-bold text-sm px-4 py-2 rounded-lg transition-colors min-h-[40px] whitespace-nowrap"
      >
        Tutte le guide
      </a>
      <button
        id="menu-toggle"
        class="lg:hidden p-2.5 rounded-lg text-brand-dark hover:bg-brand-bg transition-colors"
        aria-label="Apri il menu di navigazione"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-gray-100"
    role="navigation"
    aria-label="Menu mobile"
  >
    <div class="px-4 py-3 space-y-1">
      {
        Object.entries(CATEGORIES).map(([key, c]) => (
          <a
            href={`/categoria/${key}`}
            class:list={[
              'flex items-center gap-3 px-3 py-3 rounded-xl text-base font-medium transition-colors',
              isActive(`/categoria/${key}`)
                ? 'bg-brand-blue-light text-brand-blue'
                : 'text-brand-dark hover:bg-brand-bg',
            ]}
          >
            <span class="text-xl w-7 text-center" aria-hidden="true">{c.emoji}</span>
            {c.label}
          </a>
        ))
      }
      <div class="pt-2 border-t border-gray-100 mt-2">
        <a
          href="/tutorial"
          class="flex items-center justify-center bg-brand-orange hover:bg-brand-orange-dk text-brand-dark font-bold py-3 px-4 rounded-xl min-h-[48px] text-base transition-colors"
        >
          Tutte le guide
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const iMenu  = document.getElementById('icon-menu');
  const iClose = document.getElementById('icon-close');
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iMenu?.classList.toggle('hidden', !isOpen);
    iClose?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Apri il menu di navigazione' : 'Chiudi il menu');
  });
</script>
