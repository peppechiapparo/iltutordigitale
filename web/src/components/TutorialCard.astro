---
import type { SiteCategory } from '@/data/site';

interface Props {
  href: string;
  title: string;
  description: string;
  category: SiteCategory;
  categoryLabel: string;
  pubDate: Date;
}
const { href, title, description, categoryLabel, pubDate } = Astro.props;

const dateStr = pubDate.toLocaleDateString('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<a
  href={href}
  class="group flex flex-col bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-200 overflow-hidden focus-visible:outline-3 focus-visible:outline-brand-orange"
>
  <div class="h-1.5 bg-brand-orange flex-shrink-0"></div>
  <div class="p-6 flex flex-col flex-1">
    <span class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-brand-blue bg-brand-blue-light px-3 py-1 rounded-full w-fit mb-3">
      {categoryLabel}
    </span>
    <h3 class="font-heading text-xl font-bold text-brand-dark group-hover:text-brand-blue transition-colors leading-snug flex-1">
      {title}
    </h3>
    <p class="mt-2 text-brand-mid text-sm leading-relaxed line-clamp-2">
      {description}
    </p>
    <div class="mt-4 flex items-center justify-between">
      <time datetime={pubDate.toISOString()} class="text-xs text-brand-mid">
        {dateStr}
      </time>
      <span class="text-xs font-semibold text-brand-blue group-hover:text-brand-blue-mid transition-colors">
        Leggi →
      </span>
    </div>
  </div>
</a>
