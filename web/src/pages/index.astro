---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import { SITE, CATEGORIES } from '@/data/site';
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <!-- Hero -->
  <section class="bg-brand-blue-light">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h1 class="font-heading text-3xl md:text-5xl text-brand-blue">
        Tecnologia per tutti,<br />senza paura
      </h1>
      <!-- AEO: risposta sintetica "In breve" subito dopo l'H1 (docs/10-SEO-AEO.md) -->
      <p class="mx-auto mt-5 max-w-2xl text-xl text-brand-dark">
        Guide semplici e chiare per imparare a usare smartphone, PC e internet.
        Spiegate passo dopo passo, senza fretta e senza parole difficili.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href="/tutorial" variant="primary">Inizia da qui</Button>
        <Button href="/chi-siamo" variant="outline">Scopri chi siamo</Button>
      </div>
    </div>
  </section>

  <!-- Categorie -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="text-center font-heading text-2xl md:text-3xl text-brand-dark">
      Cosa vuoi imparare oggi?
    </h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        Object.entries(CATEGORIES).map(([key, c]) => (
          <Card href={`/categoria/${key}`}>
            <p class="text-4xl" aria-hidden="true">{c.emoji}</p>
            <p class="mt-3 font-heading text-xl text-brand-blue">{c.label}</p>
            <p class="mt-1 text-brand-mid">Guide passo passo per {c.label.toLowerCase()}.</p>
          </Card>
        ))
      }
    </div>
  </section>
</BaseLayout>
