---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import TutorialCard from '@/components/TutorialCard.astro';
import { SITE, CATEGORIES } from '@/data/site';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorial', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6);

// Conteggio per categoria
const allTutorials = await getCollection('tutorial', ({ data }) => !data.draft);
const countByCat = Object.fromEntries(
  Object.keys(CATEGORIES).map((k) => [
    k,
    allTutorials.filter((t) => t.data.category === k).length,
  ])
);
---

<BaseLayout title={SITE.name} description={SITE.description}>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-blue-light via-white to-white">
    <!-- Decorazione sfondo -->
    <div class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 rounded-full bg-brand-blue opacity-5" aria-hidden="true"></div>
    <div class="pointer-events-none absolute bottom-0 left-0 w-64 h-64 rounded-full bg-brand-orange opacity-5" aria-hidden="true"></div>

    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Colonna testo -->
        <div>
          <!-- Badge -->
          <span class="inline-flex items-center gap-2 bg-brand-blue text-white text-sm font-semibold px-4 py-1.5 rounded-full mb-6">
            <span aria-hidden="true">🎓</span> Guide in italiano, semplici e chiare
          </span>

          <h1 class="font-heading text-4xl md:text-5xl lg:text-5xl text-brand-dark leading-tight tracking-tight">
            La tecnologia<br class="hidden sm:inline" />
            <span class="text-brand-blue">non fa paura</span><br class="hidden sm:inline" />
            se qualcuno la spiega bene
          </h1>

          <p class="mt-6 text-xl text-brand-mid max-w-xl leading-relaxed">
            Guide passo dopo passo su smartphone, PC, WhatsApp e molto altro.
            Scritte per chi parte da zero, senza fretta e senza parole difficili.
          </p>

          <div class="mt-10 flex flex-wrap gap-4">
            <Button href="/tutorial" variant="primary" class="text-lg px-8 py-4 shadow-md hover:shadow-lg">
              Inizia da qui — è gratis
            </Button>
            <Button href="/chi-siamo" variant="outline" class="text-lg px-8 py-4">
              Chi siamo
            </Button>
          </div>

          <!-- Social proof -->
          <div class="mt-10 flex flex-wrap items-center gap-6 text-sm text-brand-mid">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-orange" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              Guide verificate e aggiornate
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Nessuna registrazione richiesta
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Lettura: 3–5 minuti per guida
            </span>
          </div>
        </div>

        <!-- Colonna video -->
        <div class="flex flex-col items-center">
          <div class="w-full rounded-2xl overflow-hidden shadow-2xl aspect-video bg-brand-dark">
            <iframe
              src="https://www.youtube-nocookie.com/embed/kiwrfyxaBqo?rel=0&modestbranding=1"
              title="Presentazione Il Tutor Digitale"
              class="w-full h-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <p class="mt-3 text-sm text-brand-mid text-center">
            Guarda la presentazione del Tutor Digitale
          </p>
        </div>

      </div>
    </div>
  </section>  </section>

  <!-- ── STATS BAR ───────────────────────────────────────────── -->
  <section class="bg-brand-dark py-10" aria-label="Il Tutor Digitale in numeri">
    <div class="mx-auto max-w-5xl px-4">
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center list-none m-0 p-0">
        <li>
          <p class="font-heading text-4xl font-bold text-brand-orange" aria-label="{allTutorials.length} guide disponibili">
            {allTutorials.length}
          </p>
          <p class="text-white/70 text-base mt-1">Guide disponibili</p>
        </li>
        <li>
          <p class="font-heading text-4xl font-bold text-brand-orange">
            {Object.keys(CATEGORIES).length}
          </p>
          <p class="text-white/70 text-base mt-1">Argomenti</p>
        </li>
        <li>
          <p class="font-heading text-4xl font-bold text-brand-orange">100%</p>
          <p class="text-white/70 text-base mt-1">Gratuito</p>
        </li>
        <li>
          <p class="font-heading text-4xl font-bold text-brand-orange">0</p>
          <p class="text-white/70 text-base mt-1">Registrazioni richieste</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ── COME FUNZIONA ────────────────────────────────────────── -->
  <section class="bg-white py-16 md:py-20 border-b border-gray-100">
    <div class="mx-auto max-w-6xl px-4">
      <div class="text-center mb-12">
        <h2 class="font-heading text-3xl md:text-4xl text-brand-dark">
          Come funziona?
        </h2>
        <p class="mt-3 text-brand-mid text-lg max-w-xl mx-auto">
          Tre passi semplici. Nessuna registrazione, nessun costo.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        <!-- Step 1 -->
        <div class="relative flex flex-col items-center text-center">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-brand-blue text-white font-heading font-bold text-2xl shadow-md mb-5">
            1
          </div>
          <!-- Connettore (solo desktop) -->
          <div class="hidden md:block absolute top-8 left-[calc(50%+2.5rem)] w-[calc(100%-5rem)] h-0.5 bg-brand-blue-light" aria-hidden="true"></div>
          <h3 class="font-heading text-xl text-brand-dark mb-2">Scegli l'argomento</h3>
          <p class="text-brand-mid leading-relaxed">
            Smartphone, WhatsApp, PC o sicurezza online: scegli quello che ti mette in difficoltà.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative flex flex-col items-center text-center">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-brand-orange text-brand-dark font-heading font-bold text-2xl shadow-md mb-5">
            2
          </div>
          <div class="hidden md:block absolute top-8 left-[calc(50%+2.5rem)] w-[calc(100%-5rem)] h-0.5 bg-brand-blue-light" aria-hidden="true"></div>
          <h3 class="font-heading text-xl text-brand-dark mb-2">Segui la guida passo dopo passo</h3>
          <p class="text-brand-mid leading-relaxed">
            Ogni guida è scritta con parole semplici e immagini chiare. Puoi fermarti e riprendere quando vuoi.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="flex flex-col items-center text-center">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-brand-blue text-white font-heading font-bold text-2xl shadow-md mb-5">
            3
          </div>
          <h3 class="font-heading text-xl text-brand-dark mb-2">Hai dubbi? Chiedi!</h3>
          <p class="text-brand-mid leading-relaxed">
            Non hai capito qualcosa? Scrivimi direttamente. Nessuna domanda è troppo semplice.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── DOMANDE FREQUENTI ────────────────────────────────────── -->
  <section class="bg-white py-16 md:py-20 border-b border-gray-100" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-3xl px-4">
      <div class="text-center mb-10">
        <h2 id="faq-heading" class="font-heading text-3xl md:text-4xl text-brand-dark">
          Domande frequenti
        </h2>
        <p class="mt-3 text-brand-mid text-lg">
          Le risposte alle domande che ci fanno più spesso.
        </p>
      </div>
      <div class="space-y-4">
        <details class="group rounded-2xl border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 font-semibold text-brand-dark text-lg hover:bg-brand-blue-light transition-colors list-none">
            Devo registrarmi per leggere le guide?
            <span class="ml-auto shrink-0 w-6 h-6 text-brand-blue transition-transform group-open:rotate-45" aria-hidden="true">
              <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            </span>
          </summary>
          <div class="px-6 pb-5 text-brand-mid leading-relaxed border-t border-gray-100 pt-4">
            No. Tutte le guide sono libere e gratuite. Nessuna registrazione, nessun account, nessuna email da inserire. Apri la guida e leggi, subito.
          </div>
        </details>

        <details class="group rounded-2xl border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 font-semibold text-brand-dark text-lg hover:bg-brand-blue-light transition-colors list-none">
            Le guide funzionano anche su iPhone e iPad?
            <span class="ml-auto shrink-0 w-6 h-6 text-brand-blue transition-transform group-open:rotate-45" aria-hidden="true">
              <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            </span>
          </summary>
          <div class="px-6 pb-5 text-brand-mid leading-relaxed border-t border-gray-100 pt-4">
            Sì. Il sito funziona perfettamente su qualsiasi dispositivo: smartphone Android, iPhone, iPad, tablet e computer. Se una guida riguarda funzioni specifiche di Android o iOS, lo diciamo sempre in apertura.
          </div>
        </details>

        <details class="group rounded-2xl border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 font-semibold text-brand-dark text-lg hover:bg-brand-blue-light transition-colors list-none">
            Non trovo la guida che mi serve. Posso chiederti aiuto?
            <span class="ml-auto shrink-0 w-6 h-6 text-brand-blue transition-transform group-open:rotate-45" aria-hidden="true">
              <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            </span>
          </summary>
          <div class="px-6 pb-5 text-brand-mid leading-relaxed border-t border-gray-100 pt-4">
            Assolutamente sì. Puoi scrivere via email o, se hai attivato WhatsApp, direttamente in chat. Rispondo a tutti, in italiano, senza usare termini tecnici. Nessuna domanda è troppo semplice.
          </div>
        </details>

        <details class="group rounded-2xl border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 font-semibold text-brand-dark text-lg hover:bg-brand-blue-light transition-colors list-none">
            Chi c'è dietro al Tutor Digitale?
            <span class="ml-auto shrink-0 w-6 h-6 text-brand-blue transition-transform group-open:rotate-45" aria-hidden="true">
              <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            </span>
          </summary>
          <div class="px-6 pb-5 text-brand-mid leading-relaxed border-t border-gray-100 pt-4">
            Siamo Abby e Giuseppe. Appassionati di tecnologia e stufi di vedere amici e familiari in difficoltà con smartphone e computer, abbiamo creato questo spazio per dare risposte chiare, senza complicazioni, a chi parte da zero.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- ── CATEGORIE ─────────────────────────────────────────────── -->
  <section class="bg-brand-bg py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="text-center mb-12">
        <h2 class="font-heading text-3xl md:text-4xl text-brand-dark">
          Cosa vuoi imparare oggi?
        </h2>
        <p class="mt-3 text-brand-mid text-lg max-w-xl mx-auto">
          Scegli l'argomento che ti interessa. Ogni guida parte dal principio.
        </p>
      </div>

      <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {
          Object.entries(CATEGORIES).map(([key, c]) => (
            <CategoryCard
              categoryKey={key as any}
              label={c.label}
              description={c.description}
              count={countByCat[key] ?? 0}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── ULTIMI TUTORIAL ────────────────────────────────────────── -->
  {tutorials.length > 0 && (
    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto max-w-6xl px-4">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
          <div>
            <h2 class="font-heading text-3xl md:text-4xl text-brand-dark">
              Le ultime guide
            </h2>
            <p class="mt-2 text-brand-mid">Nuovi tutorial ogni settimana</p>
          </div>
          <a
            href="/tutorial"
            class="inline-flex items-center gap-2 text-brand-blue font-semibold hover:text-brand-blue-mid transition-colors whitespace-nowrap"
          >
            Vedi tutte le guide
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
          </a>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            tutorials.map((t) => (
              <TutorialCard
                href={`/tutorial/${t.slug}`}
                title={t.data.title}
                description={t.data.description}
                category={t.data.category}
                categoryLabel={CATEGORIES[t.data.category].label}
                pubDate={t.data.pubDate}
              />
            ))
          }
        </div>
      </div>
    </section>
  )}

  <!-- ── PERCHÉ IL TUTOR DIGITALE ────────────────────────────── -->
  <section class="bg-brand-bg py-16 md:py-20" aria-labelledby="perche-heading">
    <div class="mx-auto max-w-6xl px-4">
      <div class="text-center mb-12">
        <h2 id="perche-heading" class="font-heading text-3xl md:text-4xl text-brand-dark">
          Perché il Tutor Digitale?
        </h2>
        <p class="mt-3 text-brand-mid text-lg max-w-xl mx-auto">
          Guide pensate su misura per chi parte da zero.
        </p>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-8 list-none p-0 m-0">
        <li class="bg-white rounded-2xl p-8 shadow-sm text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-blue-light mb-5" aria-hidden="true">
            <svg class="w-8 h-8 text-brand-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="font-heading text-xl text-brand-dark mb-3">Linguaggio semplice</h3>
          <p class="text-brand-mid leading-relaxed">
            Nessun termine tecnico non spiegato. Ogni guida usa parole di tutti i giorni, con esempi pratici e passaggi uno alla volta.
          </p>
        </li>
        <li class="bg-white rounded-2xl p-8 shadow-sm text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-blue-light mb-5" aria-hidden="true">
            <svg class="w-8 h-8 text-brand-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-heading text-xl text-brand-dark mb-3">Su tutti i dispositivi</h3>
          <p class="text-brand-mid leading-relaxed">
            Che tu abbia uno smartphone Android, un iPhone, un tablet o un PC, le guide sono ottimizzate per ogni schermo.
          </p>
        </li>
        <li class="bg-white rounded-2xl p-8 shadow-sm text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-blue-light mb-5" aria-hidden="true">
            <svg class="w-8 h-8 text-brand-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="font-heading text-xl text-brand-dark mb-3">Gratis, sempre</h3>
          <p class="text-brand-mid leading-relaxed">
            Nessuna registrazione, nessun abbonamento, nessuna sorpresa. Tutte le guide sono libere e accessibili a chiunque.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ── CTA BANNER ─────────────────────────────────────────────── -->
  <section class="bg-brand-blue">
    <div class="mx-auto max-w-5xl px-4 py-14">
      <div class="flex flex-col md:flex-row md:items-center gap-8 md:gap-12">
        <!-- Testo -->
        <div class="flex-1">
          <p class="text-brand-orange font-semibold text-sm uppercase tracking-wider mb-2">Non sei ancora convinto?</p>
          <h2 class="font-heading text-3xl md:text-4xl text-white leading-tight">
            Hai ancora dubbi o non trovi la guida che cerchi?
          </h2>
          <p class="mt-4 text-brand-blue-light text-lg max-w-lg">
            Scrivimi su WhatsApp o via email: rispondo personalmente, in italiano,
            senza tecnicismi. Nessuna domanda è troppo banale.
          </p>
        </div>
        <!-- CTA buttons -->
        <div class="flex flex-col sm:flex-row md:flex-col gap-3 md:min-w-[220px]">
          {SITE.whatsapp ? (
            <a
              href={`https://wa.me/${SITE.whatsapp}?text=Ciao%2C%20ho%20una%20domanda%20sulla%20tecnologia...`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-base px-6 py-4 rounded-xl min-h-[52px] transition-colors shadow-md"
            >
              <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Scrivimi su WhatsApp
            </a>
          ) : (
            <a
              href="/contatti"
              class="inline-flex items-center justify-center gap-2.5 bg-brand-orange hover:bg-brand-orange-dk text-brand-dark font-bold text-base px-6 py-4 rounded-xl min-h-[52px] transition-colors shadow-md"
            >
              Scrivimi una domanda
            </a>
          )}
          <a
            href={`mailto:${SITE.email}`}
            class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-brand-blue font-bold text-base px-6 py-4 rounded-xl min-h-[52px] transition-colors"
          >
            Invia una email
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
