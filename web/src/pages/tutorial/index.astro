---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TutorialCard from '@/components/TutorialCard.astro';
import { CATEGORIES } from '@/data/site';

const tutorials = (await getCollection('tutorial', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Tutorial"
  description="Tutte le guide passo passo: smartphone, PC, WhatsApp e molto altro. Spiegate in modo semplice per chi inizia da zero."
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-heading text-3xl md:text-4xl text-brand-blue">Tutti i tutorial</h1>
    <p class="mt-3 text-brand-mid">
      Guide semplici e chiare. Scegli l'argomento che ti interessa e seguile passo dopo passo.
    </p>

    <!-- Filtri categoria -->
    <nav class="mt-8 flex flex-wrap gap-2" aria-label="Filtra per categoria">
      <a
        href="/tutorial"
        class="rounded-full bg-brand-blue text-white px-4 py-1.5 text-sm font-medium"
      >Tutti</a>
      {
        Object.entries(CATEGORIES).map(([key, c]) => (
          <a
            href={`/categoria/${key}`}
            class="rounded-full border border-brand-blue text-brand-blue px-4 py-1.5 text-sm font-medium hover:bg-brand-blue-light transition-colors"
          >
            {c.label}
          </a>
        ))
      }
    </nav>

    {tutorials.length === 0 && (
      <p class="mt-12 text-center text-brand-mid">
        Nessun tutorial ancora disponibile. Torna presto!
      </p>
    )}

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        tutorials.map((tutorial) => (
          <TutorialCard
            href={`/tutorial/${tutorial.slug}`}
            title={tutorial.data.title}
            description={tutorial.data.description}
            category={tutorial.data.category}
            categoryLabel={CATEGORIES[tutorial.data.category].label}
            pubDate={tutorial.data.pubDate}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
